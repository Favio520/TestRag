{
  "id": "rag-search",
  "name": "RAG Search",
  "description": "Consulta una API RAG local y devuelve fragmentos relevantes.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string",
        "default": "http://127.0.0.1:8000",
        "description": "Base URL de la API RAG."
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 120000,
        "default": 30000,
        "description": "Timeout HTTP en milisegundos."
      },
      "topK": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "default": 3,
        "description": "Numero de fragmentos por defecto."
      },
      "searchType": {
        "type": "string",
        "enum": ["mmr", "similarity", "similarity_with_score"],
        "default": "similarity_with_score",
        "description": "Estrategia de recuperacion. MMR reduce fragmentos repetidos."
      },
      "chunkSize": {
        "type": "integer",
        "minimum": 100,
        "maximum": 4000,
        "default": 900,
        "description": "Tamano de chunk para indexacion."
      },
      "chunkOverlap": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000,
        "default": 180,
        "description": "Solapamiento entre chunks consecutivos."
      }
    }
  }
}
